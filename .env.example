# =======================================================
# NEWS24 NETWORK - ENVIRONMENT CONFIGURATION
# =======================================================

# 1. Server Environment
NODE_ENV=production
PORT=5000

# 2. Database Connection
# LOCAL DEVELOPMENT (SQLite):
DATABASE_URL="file:./dev.db"

# VERCEL / PRODUCTION (PostgreSQL - Recommended: Neon.tech, Supabase, or Vercel Postgres):
# DATABASE_URL="postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 3. Authentication (JWT)
# Generate any long secure random string for JWT_SECRET:
JWT_SECRET="news24_jwt_secret_super_secure_key_2026_production"
JWT_EXPIRES_IN="7d"

# 4. Razorpay Subscriptions (Test Mode)
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# 5. Client URL (Set to your Vercel deployment URL in production)
CLIENT_URL="https://your-news24-app.vercel.app"
